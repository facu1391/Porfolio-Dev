---
interface Props { images: string[]; title: string; compact?: boolean }
const { images, title, compact = false } = Astro.props
---
<div class="gallery" data-gallery data-count={images.length} role="group" aria-label={`Galería del proyecto ${title}`} tabindex="0">
  <div class:list={["frame", { compact }]}>
    {images.map((image, index) => <img class:list={["slide", { active: index === 0 }]} src={`/${image}`} alt={`Captura ${index + 1} de ${title}`} loading="lazy" />)}
    {images.length > 1 && <>
      <button class="arrow previous" type="button" aria-label={`Captura anterior de ${title}`} data-step="-1">‹</button>
      <button class="arrow next" type="button" aria-label={`Captura siguiente de ${title}`} data-step="1">›</button>
      <div class="dots" aria-label={`Capturas de ${title}`}>
        {images.map((_, index) => <button class:list={["dot", { active: index === 0 }]} type="button" aria-label={`Ver captura ${index + 1}`} aria-pressed={index === 0 ? "true" : "false"} data-index={index}></button>)}
      </div>
    </>}
  </div>
  {images.length > 1 && <div class="caption"><span>Galería del proyecto</span><span data-counter>01 / {String(images.length).padStart(2, "0")}</span></div>}
</div>

<script>
  const initProjectGalleries = () => {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      if (gallery.dataset.ready) return
      gallery.dataset.ready = "true"
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>(".slide"))
      const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".dot"))
      let current = 0
      const show = (requested: number) => {
        current = (requested + slides.length) % slides.length
        slides.forEach((slide, i) => slide.classList.toggle("active", i === current))
        dots.forEach((dot, i) => {
          dot.classList.toggle("active", i === current)
          dot.setAttribute("aria-pressed", String(i === current))
        })
        const counter = gallery.querySelector<HTMLElement>("[data-counter]")
        if (counter) counter.textContent = `${String(current + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`
      }
      gallery.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => button.addEventListener("click", () => show(current + Number(button.dataset.step))))
      dots.forEach((button, i) => button.addEventListener("click", () => show(i)))
      gallery.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") show(current + 1)
        if (event.key === "ArrowLeft") show(current - 1)
      })
    })
  }
  document.addEventListener("astro:page-load", initProjectGalleries)
  initProjectGalleries()
</script>

<style>
  .frame { position: relative; height: clamp(15rem, 34vw, 27rem); overflow: hidden; background: #07111e; }
  .frame.compact { height: clamp(12rem, 24vw, 18rem); }
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .3s ease; }
  .slide.active { opacity: 1; }
  .arrow { position: absolute; top: 50%; z-index: 1; display: grid; width: 2.6rem; height: 2.6rem; place-items: center; transform: translateY(-50%); border: 1px solid #ffffff38; border-radius: 50%; background: #07111ecc; color: white; font-size: 1.7rem; line-height: 1; backdrop-filter: blur(8px); transition: background .2s; }
  .arrow:hover { background: #0891b2; }
  .previous { left: .8rem; } .next { right: .8rem; }
  .dots { position: absolute; bottom: .8rem; left: 50%; z-index: 1; display: flex; max-width: calc(100% - 6rem); gap: .35rem; transform: translateX(-50%); padding: .45rem .6rem; border: 1px solid #ffffff24; border-radius: 99px; background: #07111ecc; backdrop-filter: blur(8px); }
  .dot { width: .45rem; height: .45rem; flex: 0 0 auto; border-radius: 99px; background: #ffffff80; }
  .dot.active { width: 1.25rem; background: #22d3ee; }
  .caption { display: flex; justify-content: space-between; padding: .6rem .85rem; color: #64748b; font-size: .75rem; }
  .caption [data-counter] { color: #0891b2; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>
