---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
const socialImage = "/Perfil12.png"
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111827" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="relative isolate text-black dark:text-white">
    <div
      class="fixed inset-0 z-0 pointer-events-none bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(253,224,71,0.18),rgba(255,255,255,0.92)),radial-gradient(ellipse_60%_60%_at_100%_0%,rgba(14,165,233,0.10),rgba(255,255,255,0))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(250,204,21,0.12),rgba(0,0,0,0)),radial-gradient(ellipse_60%_60%_at_100%_0%,rgba(56,189,248,0.10),rgba(0,0,0,0))]"
    ></div>

    <div class="relative z-10 w-full">
      <Header />
      <slot />
      <Footer />
    </div>

    <a
      class="whatsapp-float"
      href="https://wa.me/5493804249741?text=Hola%20Facundo%2C%20vi%20tu%20portfolio%20y%20quiero%20consultarte%20por%20un%20proyecto."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escribirle a Facundo por WhatsApp"
      title="Hablemos por WhatsApp"
    >
      <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
        <path d="M16.02 3.2A12.7 12.7 0 0 0 5.1 22.39L3.4 28.6l6.36-1.67A12.71 12.71 0 1 0 16.02 3.2Zm0 23.08c-2 0-3.97-.54-5.69-1.56l-.41-.25-3.78.99 1.01-3.68-.27-.43a10.34 10.34 0 1 1 9.14 4.93Zm5.67-7.75c-.31-.16-1.83-.9-2.12-1-.28-.1-.49-.16-.7.16-.2.31-.8 1-1 1.2-.19.21-.37.24-.68.08-.32-.16-1.34-.5-2.56-1.58a9.6 9.6 0 0 1-1.78-2.21c-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.31.32-.52.1-.21.05-.4-.03-.56-.08-.16-.7-1.69-.96-2.31-.25-.61-.51-.53-.7-.54l-.6-.01c-.21 0-.55.08-.84.4-.29.31-1.1 1.06-1.1 2.58s1.12 2.99 1.28 3.2c.16.2 2.2 3.36 5.34 4.71.75.32 1.33.51 1.79.65.75.24 1.44.21 1.98.13.61-.1 1.83-.75 2.09-1.48.26-.73.26-1.35.18-1.48-.08-.13-.29-.21-.6-.37Z" />
      </svg>
      <span>Hablemos</span>
    </a>

    <style is:global>
      :root {
        color-scheme: light dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        overflow-y: auto;
      }

      body {
        margin: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: auto;
      }

      .whatsapp-float {
        position: fixed;
        right: max(1.1rem, env(safe-area-inset-right));
        bottom: max(1.1rem, env(safe-area-inset-bottom));
        z-index: 40;
        display: flex;
        align-items: center;
        gap: .65rem;
        min-height: 3.6rem;
        padding: .78rem 1.05rem;
        border: 1px solid rgba(255,255,255,.5);
        border-radius: 999px;
        background: linear-gradient(135deg,#20c969,#05a84d);
        color: white;
        font-size: .9rem;
        font-weight: 700;
        box-shadow: 0 12px 32px rgba(4,120,70,.34), 0 0 0 0 rgba(34,197,94,.42);
        animation: whatsapp-pulse 2.5s infinite;
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .whatsapp-float:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(4,120,70,.4); }
      .whatsapp-float svg { width: 1.65rem; height: 1.65rem; flex: 0 0 auto; }
      @keyframes whatsapp-pulse {
        0%, 100% { box-shadow: 0 12px 32px rgba(4,120,70,.34), 0 0 0 0 rgba(34,197,94,.35); }
        55% { box-shadow: 0 12px 32px rgba(4,120,70,.34), 0 0 0 10px rgba(34,197,94,0); }
      }
      @media (max-width: 480px) {
        .whatsapp-float { right: max(.85rem, env(safe-area-inset-right)); bottom: max(.85rem, env(safe-area-inset-bottom)); width: 3.55rem; height: 3.55rem; justify-content: center; padding: .75rem; }
        .whatsapp-float span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .whatsapp-float { animation: none; }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

    </style>
  </body>
</html>
